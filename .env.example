# Deploying: `npm start` runs every migration (idempotent) before the API
# listens, so a release needs no manual step. Set SKIP_MIGRATIONS=true only
# when a separate release step already ran `npm run migrate:all`.
# See docs/release-checklist.md.

PORT=
NODE_ENV=

DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

CORS_ORIGIN=
# Set when running behind a load balancer / reverse proxy (e.g. 1 = one hop),
# so the sign-in rate limit sees the client IP instead of the proxy's.
TRUST_PROXY=

# Sign-in, forgot/reset-password rate limit per client IP, route and account
# (email); IP_MAX caps all accounts from one IP (default 5 x MAX).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_IP_MAX=50
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_DISABLED=false

# Required: the server will not start without it. Use a long random value.
JWT_SECRET=

# python_AI_service: base URLs, and the shared key it expects in X-Service-Key
OCR_SERVICE_URL=
SEA_ROUTE_API_URL=
AI_SERVICE_KEY=
# Time limits (ms) for calls to the AI service (LLM-backed, default 30000) and
# for sea-route / Google route and geocode lookups (default 15000).
AI_SERVICE_TIMEOUT_MS=30000
ROUTE_SERVICE_TIMEOUT_MS=15000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo). Without BREVO_API_KEY, MAIL_FROM and FRONTEND_URL no email goes
# out: password reset answers 503 and invites come back "not sent". The startup
# log prints one "[Mail]" line saying whether mail is on.
# API key from Brevo > SMTP & API > API keys (starts with xkeysib-).
BREVO_API_KEY=
# Sender, verified in Brevo (Senders, domains & dedicated IPs), e.g. ESGLite <no-reply@planetpulse.life>
MAIL_FROM=
# Approval, rejection, reminder and upload emails go through this queue.
RABBITMQ_URL=
# Gets an alert when a queued email fails after every retry.
ADMIN_EMAIL=

FRONTEND_URL=
# PCF supplier data requests (C06). Default "sink": the message is stored on
# the request and logged, never sent; the manager copies the link. Set to
# "live" only when the product owner has approved real supplier emails.
SUPPLIER_REQUEST_MAIL=sink
