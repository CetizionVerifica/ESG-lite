{
  "about": "KPI-13 · the KPI golden cases, worked by hand. Each suite names its owner, its file and the test that runs it; `status` is `run` once the owner has built it (KPI-13 final: every suite runs). Units and aggregation cases are inline below and run by ci/unit/kpi-golden.test.cjs, which also fails when any suite here is still `skip` or its file or runner is missing. Figures are never read back from the engine.",
  "suites": [
    { "id": "auto", "owner": "KPI-5", "status": "run", "file": "ci/golden/kpi/auto.json", "runner": "ci/api/tests/kpi-5-auto.test.cjs", "what": "auto Scope 1/2/3 equal the GHG report's own figures; energy from diesel litres (DESNZ 2025 density × IPCC NCV) and kWh; production; waste with its method; a refresh after a rejection" },
    { "id": "formulas", "owner": "KPI-6", "status": "run", "file": "ci/golden/kpi/formulas.json", "runner": "ci/unit/kpi-formulas.test.cjs", "what": "GHG intensity per revenue, energy per tonne, water consumption, women %, a missing input, division by zero" },
    { "id": "reports", "owner": "KPI-11", "status": "run", "file": "ci/golden/kpi/reports/input.json", "runner": "ci/unit/kpi-reports.test.cjs", "what": "GRI index, BRSR tables and ESRS list: units GJ/MWh/ML/kL/kg, omissions with reasons, previous year, drafts/pending/rejected left out" },
    { "id": "units", "owner": "KPI-4", "status": "run", "file": "ci/golden/kpi/cases.json", "runner": "ci/unit/kpi-golden.test.cjs", "what": "values entered in an allowed unit become the canonical unit exactly; other units are refused" },
    { "id": "aggregation", "owner": "KPI-4", "status": "run", "file": "ci/golden/kpi/cases.json", "runner": "ci/unit/kpi-golden.test.cjs", "what": "sites and periods roll up by each KPI's rule; missing never counts as 0" }
  ],
  "units": [
    { "name": "Water withdrawn in m³ is kL one for one", "kpi": "WATER_WITHDRAWAL", "value": 1200, "unit": "m3", "expected": { "value_canonical": 1200, "converted": true } },
    { "name": "Water withdrawn in ML", "kpi": "WATER_WITHDRAWAL", "value": 1.2, "unit": "ML", "working": "1.2 ML × 1,000 = 1,200 kL", "expected": { "value_canonical": 1200, "converted": true } },
    { "name": "Water withdrawn in litres", "kpi": "WATER_WITHDRAWAL", "value": 2500, "unit": "litre", "working": "2,500 L ÷ 1,000 = 2.5 kL", "expected": { "value_canonical": 2.5, "converted": true } },
    { "name": "Energy in kWh", "kpi": "ENERGY_TOTAL", "value": 10000, "unit": "kWh", "working": "10,000 kWh × 0.0036 = 36 GJ", "expected": { "value_canonical": 36, "converted": true } },
    { "name": "Energy in MWh", "kpi": "ENERGY_TOTAL", "value": 2, "unit": "MWh", "working": "2 MWh × 3.6 = 7.2 GJ", "expected": { "value_canonical": 7.2, "converted": true } },
    { "name": "Energy in TJ", "kpi": "ENERGY_TOTAL", "value": 0.5, "unit": "TJ", "working": "0.5 TJ × 1,000 = 500 GJ", "expected": { "value_canonical": 500, "converted": true } },
    { "name": "Energy already in GJ", "kpi": "ENERGY_TOTAL", "value": 42, "unit": "GJ", "expected": { "value_canonical": 42, "converted": false } },
    { "name": "Waste in kg", "kpi": "WASTE_GENERATED", "value": 3500, "unit": "kg", "working": "3,500 kg ÷ 1,000 = 3.5 t", "expected": { "value_canonical": 3.5, "converted": true } },
    { "name": "No unit means the canonical one", "kpi": "WASTE_GENERATED", "value": 4, "unit": null, "expected": { "value_canonical": 4, "converted": false } },
    { "name": "kWh for a mass KPI is refused", "kpi": "WASTE_GENERATED", "value": 1, "unit": "kWh", "expected": { "code": "KPI_UNIT_NOT_ALLOWED" } },
    { "name": "tonnes for a volume KPI is refused", "kpi": "WATER_WITHDRAWAL", "value": 1, "unit": "tonne", "expected": { "code": "KPI_UNIT_NOT_ALLOWED" } }
  ],
  "aggregation": [
    { "name": "Water over three sites, one missing: the two present, never 0 for the third", "rule": "sum", "entries": [{ "value": 1200 }, { "value": 800 }, { "value": null }], "working": "1,200 + 800 = 2,000; one site missing", "expected": { "value": 2000, "count": 2, "missing": 1, "complete": false } },
    { "name": "Water over twelve months", "rule": "sum", "entries": [{ "value": 100 }, { "value": 110 }, { "value": 90 }, { "value": 105 }, { "value": 95 }, { "value": 100 }, { "value": 120 }, { "value": 80 }, { "value": 100 }, { "value": 100 }, { "value": 100 }, { "value": 100 }], "working": "Σ = 1,200", "expected": { "value": 1200, "count": 12, "missing": 0, "complete": true } },
    { "name": "Headcount at year end: the latest month", "rule": "latest", "entries": [{ "value": 410 }, { "value": 415 }, { "value": 420 }], "expected": { "value": 420, "count": 3, "missing": 0, "complete": true } },
    { "name": "Average of two quarters present", "rule": "average", "entries": [{ "value": 30 }, { "value": 40 }, { "value": null }, { "value": null }], "working": "(30 + 40) / 2 = 35", "expected": { "value": 35, "count": 2, "missing": 2, "complete": false } },
    { "name": "Highest monthly peak", "rule": "max", "entries": [{ "value": 7 }, { "value": 12 }, { "value": 9 }], "expected": { "value": 12, "count": 3, "missing": 0, "complete": true } },
    { "name": "LTIFR across two sites weighted by hours worked", "rule": "weighted_average", "entries": [{ "value": 2.0, "weight": 1000000 }, { "value": 5.0, "weight": 500000 }], "working": "(2.0 × 1,000,000 + 5.0 × 500,000) / 1,500,000 = 3", "expected": { "value": 3, "count": 2, "missing": 0, "complete": true } },
    { "name": "LTIFR with a site's hours missing: that site counts as missing", "rule": "weighted_average", "entries": [{ "value": 2.0, "weight": 1000000 }, { "value": 5.0, "weight": null }], "expected": { "value": 2, "count": 1, "missing": 1, "complete": false } },
    { "name": "Nothing present: no value, not 0", "rule": "sum", "entries": [{ "value": null }, { "value": null }], "expected": { "value": null, "count": 0, "missing": 2, "complete": false } },
    { "name": "A company-level (none) KPI: its single value", "rule": "none", "entries": [{ "value": 250 }], "expected": { "value": 250, "count": 1, "missing": 0, "complete": true } }
  ]
}
